		{
			"name": "Auth",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"if (pm.request.body?.mode === 'raw') {",
							"    const body = JSON.parse(pm.request.body.raw);",
							"    if (body.password) {",
							"        body.password = btoa(body.password);",
							"        pm.request.body.update({",
							"            mode: 'raw',",
							"            raw: JSON.stringify(body),",
							"            options: {",
							"                raw: {",
							"                    language: 'json'",
							"                }",
							"            }",
							"        });",
							"    }",
							"}"
						]
					}
				}
			],
			"item": [
				{
					"name": "Register",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Register successful', function () {",
									"  pm.response.to.have.status(201);",
									"});",
									"const r = pm.response.json();",
									"pm.collectionVariables.set('ACCESS_TOKEN', r.accessToken);",
									"pm.collectionVariables.set('REFRESH_TOKEN', r.refreshToken);"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
